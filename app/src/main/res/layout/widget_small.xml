<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_small"
    android:padding="12dp">

    <ImageView
        android:id="@+id/widget_cover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/widget_info_layout"
        android:scaleType="centerCrop"
        android:contentDescription="@null"
        android:src="@drawable/ic_widget_cover_placeholder" />

    <ImageButton
        android:id="@+id/widget_play"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_alignBottom="@+id/widget_cover"
        android:layout_alignEnd="@+id/widget_cover"
        android:layout_margin="6dp"
        android:background="@android:color/transparent"
        android:scaleType="fitCenter"
        android:contentDescription="Играть/пауза"
        android:src="@drawable/ic_widget_play" />

    <LinearLayout
        android:id="@+id/widget_info_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginTop="8dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:text="Ничего не играет" />

        <TextView
            android:id="@+id/widget_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#B3FFFFFF"
            android:textSize="11sp"
            android:text="Melo" />
    </LinearLayout>

</RelativeLayout>
